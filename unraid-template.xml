<?xml version="1.0"?>
<Container version="2">
  <Name>minimalist-dashboard</Name>
  <Repository>ghcr.io/kheopsian/minimalist-dashboard:main</Repository>
  <Registry>https://github.com/Kheopsian/minimalist-dashboard/pkgs/container/minimalist-dashboard</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/Kheopsian/minimalist-dashboard/issues</Support>
  <Project>https://github.com/Kheopsian/minimalist-dashboard</Project>
  <Overview>A lightweight, real-time server monitoring dashboard built with Go and vanilla JavaScript. Provides a clean web interface to display live system metrics with real-time updates via WebSockets.</Overview>
  <Category>Tools:Utilities Status:Stable</Category>
  <WebUI>http://[IP]:[PORT:9254]</WebUI>
  <TemplateURL/>
  <Icon>https://raw.githubusercontent.com/Kheopsian/minimalist-dashboard/main/frontend/assets/images/favicon.png</Icon>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Description>A lightweight, real-time server monitoring dashboard built with Go and vanilla JavaScript. Provides a clean web interface to display live system metrics with real-time updates via WebSockets.</Description>
  <Networking>
    <Mode>bridge</Mode>
    <Publish>
      <Port>
        <HostPort>9254</HostPort>
        <ContainerPort>9254</ContainerPort>
        <Protocol>tcp</Protocol>
      </Port>
    </Publish>
  </Networking>
  <Data>
    <Volume>
      <HostDir>/mnt/user/appdata/minimalist-dashboard/</HostDir>
      <ContainerDir>/app/data</ContainerDir>
      <Mode>ro</Mode>
    </Volume>
    <Volume>
      <HostDir>/var/run/docker.sock</HostDir>
      <ContainerDir>/var/run/docker.sock</ContainerDir>
      <Mode>ro</Mode>
    </Volume>
    <Volume>
      <HostDir>/mnt/user/media/</HostDir>
      <ContainerDir>/mnt/media</ContainerDir>
      <Mode>ro</Mode>
    </Volume>
  </Data>
  <Environment/>
  <Labels/>
  <Config Name="WebUI Port" Target="9254" Default="9254" Mode="tcp" Description="WebUI Port" Type="Port" Display="always" Required="true" Mask="false">9254</Config>
  <Config Name="Appdata Directory" Target="/app/data" Default="/mnt/user/appdata/minimalist-dashboard/" Mode="ro" Description="Path to your application data directory containing config.json and optionally zpool_status.txt." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/minimalist-dashboard/</Config>
  <Config Name="Docker Socket" Target="/var/run/docker.sock" Default="/var/run/docker.sock" Mode="ro" Description="Docker socket for container monitoring" Type="Path" Display="always" Required="true" Mask="false">/var/run/docker.sock</Config>
  <Config Name="Media Folder" Target="/mnt/media" Default="/mnt/user/media/" Mode="ro" Description="Path to your main media directory (optional if you don't monitor media)" Type="Path" Display="always" Required="false" Mask="false">/mnt/user/media/</Config>
</Container>
